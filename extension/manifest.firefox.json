{
  "manifest_version": 3,
  "name": "I Want This",
  "version": "1.0.0",
  "description": "Ajoutez en un clic le produit affiché à votre liste de cadeaux I Want This.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ajouter à ma liste I Want This",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "iwt@greggoem.github.io",
      "strict_min_version": "121.0"
    }
  }
}
